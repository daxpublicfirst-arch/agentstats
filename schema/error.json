{"$id":"https://github.com/daxpublicfirst-arch/agentstats/schema/error.json","$schema":"https://json-schema.org/draft/2020-12/schema","description":"Printed as one JSON object on failure. Exit 2 is a usage or input error, exit 3 is a tool failure. Exit 1 is not an error: it is the empty answer when no transcript is found.","properties":{"error":{"properties":{"blocked":{"type":"string"},"code":{"enum":["NO_TRANSCRIPT","USAGE","INVALID_INPUT","INPUT_TOO_LARGE","READ_ERROR","WRITE_ERROR","TIMEOUT","TOOL_FAILURE"],"type":"string"},"fix":{"type":"string"},"if_that_fails":{"type":"string"}},"required":["code","blocked","fix","if_that_fails"],"type":"object"},"ok":{"const":false,"type":"boolean"}},"required":["ok","error"],"title":"agentstats failure envelope","type":"object"}