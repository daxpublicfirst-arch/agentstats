{"$id":"https://github.com/daxpublicfirst-arch/agentstats/schema/request.json","$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"description":"Optional arabica-plugin-v1 envelope read with --request <path>. The CLI also works with plain flags.","properties":{"args":{"additionalProperties":false,"properties":{"out":{"description":"Absolute output directory; agentstats.json is written inside it.","type":"string"},"session":{"description":"Absolute transcript directory or .jsonl file.","type":"string"}},"type":"object"},"command":{"enum":["session","compare","top","self-test","doctor","version"],"type":"string"},"protocol":{"const":"arabica-plugin-v1","type":"string"}},"required":["protocol","command"],"title":"agentstats adapter request envelope","type":"object"}